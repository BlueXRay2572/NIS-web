PORT=3000
DB_FILE=data.db
# SMTP (Gmail: dùng App Password; hoặc SMTP của công ty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@company.com
SMTP_PASS=your-app-password
MAIL_FROM="Company Sales <you@company.com>"
# Email nội bộ nhận yêu cầu báo giá (nhiều địa chỉ cách nhau bởi dấu phẩy)
SALES_TO=sales@company.com

# Khi deploy trên Render free: dùng Brevo API (SMTP bị chặn). Nếu có BREVO_API_KEY thì SMTP_* ở trên bị bỏ qua.
BREVO_API_KEY=
MAIL_FROM_EMAIL=you@company.com
MAIL_FROM_NAME=NIS INTEGRATION SOLUTIONS
